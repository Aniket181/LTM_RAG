# =============================================
# RAG Scholarship Intelligence System
# .gitignore
# =============================================

# ---------------------------
# Virtual Environment
# ---------------------------
venvrag/
venv/
env/
.env
.venv/

# ---------------------------
# Environment Variables
# ---------------------------
.env
.env.local
.env.*.local
*.env

# ---------------------------
# Python
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ---------------------------
# Testing & Coverage
# ---------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ---------------------------
# Type checking
# ---------------------------
.mypy_cache/
.dmypy.json
dmypy.json

# ---------------------------
# Database Files
# ---------------------------
*.db
*.sqlite
*.sqlite3

# ---------------------------
# Vector Store / Embeddings (local dev only)
# ---------------------------
chroma_db/
data/embeddings/
data/raw/*.pdf
*.index

# ---------------------------
# Logs
# ---------------------------
*.log
logs/

# ---------------------------
# IDE / Editor
# ---------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------------------------
# OS
# ---------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------
# Jupyter
# ---------------------------
.ipynb_checkpoints/
*.ipynb

# ---------------------------
# Frontend (Next.js / Node)
# ---------------------------
node_modules/
.next/
out/
frontend/.env.local
frontend/.env.production
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------
# Docker
# ---------------------------
docker-compose.override.yml

# ---------------------------
# Alembic (generated migration files are committed, not this)
# ---------------------------
# (migrations/versions/*.py are intentionally tracked)

# ---------------------------
# Secrets / Credentials — NEVER commit these
# ---------------------------
*.pem
*.key
secrets/
credentials/
