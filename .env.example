# Environment Variables — RAG Scholarship Intelligence System
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================
# APPLICATION
# =============================================
APP_NAME="RAG Scholarship Intelligence System"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# =============================================
# API SERVER
# =============================================
API_HOST="0.0.0.0"
API_PORT=8000
# CORS origins (comma-separated, for development)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# =============================================
# DATABASE (PostgreSQL)
# =============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_scholarship_db

# Assembled from above (or you can set this directly)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/rag_scholarship_db

# =============================================
# VECTOR STORE
# =============================================
# Options: "chromadb" (dev) | "pgvector" (prod)
VECTOR_STORE_TYPE=chromadb
CHROMA_DB_PATH=./chroma_db

# =============================================
# EMBEDDING MODEL
# =============================================
# Local model via sentence-transformers (no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# =============================================
# LLM PROVIDER
# =============================================
# Options: "mock" | "openai" | "google" | "anthropic"
LLM_PROVIDER=mock

# --- OpenAI (if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (if LLM_PROVIDER=google) ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# --- Anthropic (if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================
# RAG PIPELINE
# =============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RERANKER_TOP_K=3

# =============================================
# HYBRID RETRIEVAL WEIGHTS
# =============================================
# Must sum to 1.0
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# =============================================
# RECOMMENDATION SCORING WEIGHTS
# =============================================
# Must sum to 1.0
SCORE_WEIGHT_SEMANTIC=0.35
SCORE_WEIGHT_ELIGIBILITY=0.30
SCORE_WEIGHT_COURSE=0.15
SCORE_WEIGHT_ACADEMIC=0.10
SCORE_WEIGHT_DEADLINE=0.10
